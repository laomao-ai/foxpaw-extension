{
  "manifest_version": 3,
  "name": "FoxPaw · 狐爪",
  "version": "1.33.2",
  "description": "云端 Agent 在你本地浏览器里的眼和手：借你的登录态读页、填表、操作。站点白名单、动作分级、关键动作由人确认。",
  "icons": {
    "128": "icons/foxpaw-128.png",
    "16": "icons/foxpaw-16.png",
    "32": "icons/foxpaw-32.png",
    "48": "icons/foxpaw-48.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/foxpaw-16.png",
      "32": "icons/foxpaw-32.png"
    },
    "default_title": "FoxPaw · 狐爪"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "vaultcatch.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "alarms",
    "webNavigation",
    "debugger",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "key": ""
}
