{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.34.0",
  "description": "__MSG_extDesc__",
  "icons": {
    "128": "icons/foxpaw-128.png",
    "16": "icons/foxpaw-16.png",
    "32": "icons/foxpaw-32.png",
    "48": "icons/foxpaw-48.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/foxpaw-16.png",
      "32": "icons/foxpaw-32.png"
    },
    "default_title": "__MSG_extName__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "vaultcatch.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "alarms",
    "webNavigation",
    "debugger",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "key": ""
}
